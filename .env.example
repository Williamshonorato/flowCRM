DATABASE_URL="postgresql://user@localhost:5432/flowcrm_dev"
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"
PLATFORM_JWT_SECRET="troque-por-outro-segredo-forte-diferente-do-de-cima"
PORT=3333
NODE_ENV=development

# Integração Gmail + Google Calendar (mesmo app OAuth) — criar em https://console.cloud.google.com/apis/credentials
# Habilitar Gmail API e Calendar API no mesmo projeto.
# Authorized redirect URIs: http://localhost:3333/gmail/callback, http://localhost:3333/calendar/callback
# e http://localhost:3333/auth/google/callback (esse último é o "Entrar com Google" da tela de login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3333/calendar/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3333/auth/google/callback

# Integração Outlook / Microsoft 365 (OAuth) — criar em https://entra.microsoft.com
# App registrations → New registration → Web → redirect URI abaixo → Certificates & secrets → New client secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3333/outlook/callback
