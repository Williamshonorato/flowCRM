generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ── TENANT (empresa cliente do CRM) ──────────────────────────────────────────
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  segment     String   @default("other")
  cnpj        String?
  phone       String?
  address     String?
  website     String?
  logoUrl     String?
  plan        String   @default("starter") // starter | professional | connected | enterprise
  active      Boolean  @default(true)
  apiKey      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  contacts     Contact[]
  deals        Deal[]
  tasks        Task[]
  stages       Stage[]
  customFields CustomField[]
  integrations    Integration[]
  activities      Activity[]
  imports         ImportLog[]
  automationRules AutomationRule[]
  dispatches      AutomationDispatch[]
  members         Member[]
  contributions   Contribution[]
  expenses        TreasuryExpense[]
  automationFlows AutomationFlow[]
  flowRuns        AutomationFlowRun[]
  broadcasts      Broadcast[]
}

// ── AUTOMATION FLOW (fluxo de automação genérico, editável) ──────────────────
// steps é uma lista livre de passos: [{ id, type, config }] — sem limite de
// quantidade nem de tipo, cada tipo tem seu próprio formato de config.
model AutomationFlow {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  active        Boolean  @default(true)
  triggerType   String   // contact_created | deal_created | deal_stage_changed | deal_closed | manual
  triggerConfig Json     @default("{}")
  steps         Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationFlowRun[]

  @@index([tenantId])
}

model AutomationFlowRun {
  id         String    @id @default(cuid())
  tenantId   String
  flowId     String
  contactId  String?
  dealId     String?
  status       String    @default("running") // running | waiting | waiting_reply | completed | failed
  stepIndex    Int       @default(0)
  resumeAt     DateTime?
  currentSteps Json?     // array de passos "ativa" no momento — muda quando entra numa opção de menu
  log          Json      @default("[]")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow   AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, resumeAt])
}

// ── MEMBER (inscrito no sindicato) ────────────────────────────────────────────
model Member {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  document     String?   // CPF
  registration String?   // matrícula funcional
  rank         String?   // categoria / cargo
  email        String?
  phone        String?
  status       String    @default("active") // active | inactive
  joinedAt     DateTime  @default(now())
  notes        String?
  customData   Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@index([tenantId])
  @@unique([tenantId, document])
}

// ── CONTRIBUTION (mensalidade paga pelo inscrito) ─────────────────────────────
model Contribution {
  id        String    @id @default(cuid())
  tenantId  String
  memberId  String
  amount    Decimal   @default(0) @db.Decimal(12, 2)
  dueDate   DateTime
  paidAt    DateTime?
  status    String    @default("pending") // pending | paid | overdue
  reference String?   // ex: "mensalidade 08/2026"
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([memberId])
  @@index([tenantId, status])
}

// ── TREASURY EXPENSE (despesa administrativa do sindicato) ───────────────────
model TreasuryExpense {
  id          String   @id @default(cuid())
  tenantId    String
  description String
  category    String?
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, date])
}

// ── USER ─────────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  // Único no sistema inteiro, não só por empresa — login busca por e-mail sem saber
  // de qual tenant é a pessoa, então duas contas com o mesmo e-mail em empresas
  // diferentes fariam login pegar a errada dependendo da ordem de busca no banco.
  email     String   @unique
  password  String
  role      String   @default("user") // admin | user | viewer
  // null pra usuário normal de empresa. "owner"/"superadmin" dá acesso extra ao painel
  // da plataforma (ver e entrar como admin em qualquer empresa) — mesmo login, mesma
  // conta, só um campo a mais liberando uma tela extra no menu.
  platformRole String?
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks     Task[]
  activities Activity[]
  assignedContacts Contact[] @relation("ContactAssignee")

  @@unique([tenantId, email])
}

// ── STAGE (etapas do pipeline — configuráveis por tenant) ─────────────────────
model Stage {
  id       String @id @default(cuid())
  tenantId String
  name     String
  color    String @default("#64748b")
  order    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@unique([tenantId, name])
}

// ── CUSTOM FIELD ──────────────────────────────────────────────────────────────
model CustomField {
  id       String @id @default(cuid())
  tenantId String
  name     String
  type     String @default("text") // text | number | date | select
  required Boolean @default(false)
  order    Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ── CONTACT ───────────────────────────────────────────────────────────────────
model Contact {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String?
  phone        String?
  company      String?
  origin       String?  // whatsapp | indicacao | instagram | google_ads | outro
  temperature  String   @default("new") // hot | warm | cold | new
  customData   Json     @default("{}")  // campos personalizados
  notes        String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User?                @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  deals      Deal[]
  messages   Message[]
  tasks      Task[]
  activities Activity[]
  dispatches AutomationDispatch[]

  @@index([tenantId, assignedToId])
  @@unique([tenantId, email])
  @@index([tenantId])
}

// Mensagens recebidas/enviadas via WhatsApp (ou integração similar)
model Message {
  id                String   @id @default(cuid())
  contactId         String?
  tenantId          String?  // preenchido nas mensagens de WhatsApp; necessário pra escopar as de grupo (sem contato)
  from              String
  to                String?
  subject           String?
  body              String
  channel           String   @default("whatsapp") // whatsapp | email
  direction         String   @default("in") // in | out
  whatsappMessageId String?  @unique
  trackingId        String?  @unique
  openedAt          DateTime?
  readAt            DateTime?
  raw               Json?
  createdAt         DateTime @default(now())

  // WhatsApp — identificação do chat e de grupo
  chatJid     String?  // remoteJid: "<numero>@s.whatsapp.net" (direto) ou "<id>@g.us" (grupo)
  isGroup     Boolean  @default(false)
  chatName    String?  // assunto do grupo (snapshot)
  senderPhone String?  // em grupo: telefone de quem enviou aquela mensagem
  senderName  String?  // em grupo: nome de exibição de quem enviou

  // WhatsApp — mídia
  mediaType String? // image | audio | video | document | sticker
  mediaUrl  String? // caminho servível: /app/uploads/whatsapp/<tenant>/<arquivo>

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([tenantId, chatJid, createdAt])
}

// ── DEAL (negócio no pipeline) ────────────────────────────────────────────────
model Deal {
  id        String   @id @default(cuid())
  tenantId  String
  contactId String?
  stageId   String
  title     String
  value     Decimal  @default(0) @db.Decimal(12, 2)
  notes     String?
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stage      Stage      @relation(fields: [stageId], references: [id])
  activities Activity[]

  @@index([tenantId])
  @@index([tenantId, stageId])
}

// ── TASK ──────────────────────────────────────────────────────────────────────
model Task {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  contactId String?
  title     String
  type      String   @default("follow") // call | follow | meet | email | note
  priority  String   @default("mid")   // high | mid | low
  dueDate   DateTime?
  doneAt    DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, dueDate])
}

// ── ACTIVITY (histórico) ──────────────────────────────────────────────────────
model Activity {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  contactId String?
  dealId    String?
  type      String   // note | call | email | whatsapp | stage_change | deal_created | contact_created
  content   String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, contactId])
}

// ── INTEGRATION ───────────────────────────────────────────────────────────────
model Integration {
  id        String   @id @default(cuid())
  tenantId  String
  type      String   // whatsapp | gmail | outlook | zapier | database | calendar
  status    String   @default("disconnected") // connected | disconnected | error
  config    Json     @default("{}")           // credenciais cifradas, webhook urls, etc
  lastSync  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

// ── IMPORT LOG ────────────────────────────────────────────────────────────────
model ImportLog {
  id          String   @id @default(cuid())
  tenantId    String
  fileName    String
  totalRows   Int      @default(0)
  imported    Int      @default(0)
  duplicates  Int      @default(0)
  errors      Int      @default(0)
  status      String   @default("processing") // processing | done | failed
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ── AUTOMATION RULE ───────────────────────────────────────────────────────────
model AutomationRule {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  inactiveDays    Int      @default(14)
  frequencyDays   Int      @default(7)
  messageTemplate String
  filters         Json     @default("{}")
  active          Boolean  @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatches AutomationDispatch[]

  @@index([tenantId])
  @@index([tenantId, active])
}

// ── AUTOMATION DISPATCH ───────────────────────────────────────────────────────
model AutomationDispatch {
  id          String   @id @default(cuid())
  tenantId    String
  ruleId      String
  contactId   String
  message     String
  status      String   @default("sent")
  sentAt      DateTime @default(now())
  readAt      DateTime?
  repliedAt   DateTime?
  convertedAt DateTime?
  createdAt   DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule    AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  contact Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ruleId])
  @@index([contactId])
}

// ── BROADCAST (disparo em massa de WhatsApp) ─────────────────────────────────
// Um disparo pra uma lista de contatos escolhida na hora (todos, por filtro, ou
// seleção manual). O envio real é feito em segundo plano pelo broadcastWorker,
// aos poucos, pra não tomar bloqueio do WhatsApp.
model Broadcast {
  id          String   @id @default(cuid())
  tenantId    String
  message     String
  mediaUrl    String?  // caminho servível de uma imagem opcional
  mediaType   String?  // image (por enquanto só imagem)
  status      String   @default("queued") // queued | sending | done | canceled
  total       Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]

  @@index([tenantId, createdAt])
  @@index([status])
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  contactId   String
  name        String?
  phone       String
  status      String    @default("pending") // pending | sent | failed | skipped
  error       String?
  sentAt      DateTime?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
}

